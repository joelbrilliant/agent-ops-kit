(version 1)
(allow default)
(deny process-exec (literal "/usr/bin/open"))
(deny process-exec (literal "/usr/bin/security"))
(deny process-exec (regex #".*[.]app/Contents/MacOS/.*"))
(deny file-read* file-write* (subpath "/Users/openclaw/.config/gh"))
(deny file-read* file-write* (subpath "/Users/openclaw/.ssh"))
(deny file-read* file-write* (subpath "/Users/openclaw/.aws"))
(deny file-read* file-write* (subpath "/Users/openclaw/.gnupg"))
(deny file-read* file-write* (subpath "/Users/openclaw/.kube"))
(deny file-read* file-write* (subpath "/Users/openclaw/.docker"))
(deny file-read* file-write* (literal "/Users/openclaw/.gitconfig"))
(deny file-read* file-write* (literal "/Users/openclaw/.git-credentials"))
(deny file-read* file-write* (literal "/Users/openclaw/.netrc"))
(deny file-read* file-write* (literal "/Users/openclaw/.npmrc"))
(deny file-read* file-write* (literal "/Users/openclaw/.hermes/.env"))
(deny file-read* file-write* (literal "/Users/openclaw/.codex/auth.json"))
(deny file-read* file-write* (subpath "/Users/openclaw/.hermes/profiles/build"))
(deny file-read* file-write* (subpath "/Users/openclaw/.hermes/profiles/review"))
