{
  "operator_logins": ["YOUR_GITHUB_LOGIN"],
  "owned_namespaces": ["YOUR_GITHUB_LOGIN"],
  "excluded_repositories": [],
  "trusted_reviewer_logins": ["copilot-pull-request-reviewer"],
  "trusted_reviewer_associations": ["OWNER", "MEMBER", "COLLABORATOR"],
  "workspace_root": "/absolute/path/to/agent-ops-workspace",
  "state_dir": "/absolute/path/to/agent-ops-state",
  "protected_path_patterns": [
    ".github/workflows/*",
    "**/credentials*",
    "**/.env*",
    "secrets/*"
  ],
  "classifier_command": [
    "python3",
    "/absolute/path/to/your-classifier.py",
    "--request",
    "{request_path}",
    "--response",
    "{response_path}"
  ],
  "builder_command": [
    "python3",
    "/absolute/path/to/your-builder.py",
    "--request",
    "{request_path}",
    "--response",
    "{response_path}",
    "--worktree",
    "{worktree_path}"
  ],
  "reviewer_command": [
    "python3",
    "/absolute/path/to/your-reviewer.py",
    "--request",
    "{request_path}",
    "--response",
    "{response_path}",
    "--worktree",
    "{worktree_path}"
  ],
  "required_runner_identity": {
    "profile": "oscar",
    "provider": "openai-codex",
    "model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "service_tier": "fast"
  },
  "capability_isolation": {
    "enabled": true,
    "environment_allowlist": ["PATH", "LANG", "LC_ALL"],
    "private_markers": ["YOUR_PRIVATE_WORKSPACE_MARKER"]
  },
  "notification_mode": "concise",
  "default_verification_commands": {
    "unit": ["python3", "-m", "pytest", "-q"]
  },
  "repository_policies": {
    "YOUR_GITHUB_LOGIN/YOUR_REPOSITORY": {
      "permitted_paths": ["src/*", "tests/*"],
      "verification_commands": {
        "package": ["python3", "-m", "build"]
      }
    },
    "*": {
      "permitted_paths": ["docs/*"],
      "verification_commands": {}
    }
  },
  "issue_automation": {
    "enabled": false,
    "enabled_repositories": {
      "YOUR_GITHUB_LOGIN/YOUR_REPOSITORY": "main"
    },
    "trigger_label": "agent-ops:ready",
    "ignore_labels": [],
    "branch_prefix": "agent-ops/issue",
    "draft_pr_title_template": "agent-ops: issue #{issue_number}",
    "issue_reply_template": "Draft PR ready: {pr_url}\nSHA: {resulting_sha}\nChecks: {named_checks}",
    "max_paths_per_issue": 8,
    "max_changed_files": 20,
    "max_diff_lines": 400,
    "classifier_command": [
      "python3",
      "/absolute/path/to/your-issue-classifier.py",
      "--request",
      "{request_path}",
      "--response",
      "{response_path}"
    ],
    "builder_command": [
      "python3",
      "/absolute/path/to/your-issue-builder.py",
      "--request",
      "{request_path}",
      "--response",
      "{response_path}",
      "--worktree",
      "{worktree_path}"
    ],
    "reviewer_command": [
      "python3",
      "/absolute/path/to/your-issue-reviewer.py",
      "--request",
      "{request_path}",
      "--response",
      "{response_path}",
      "--worktree",
      "{worktree_path}"
    ],
    "build_runner_identity": {
      "profile": "build",
      "provider": "xai-oauth",
      "model": "grok-composer-2.5-fast",
      "reasoning_effort": "low",
      "service_tier": "standard"
    },
    "review_runner_identity": {
      "profile": "review",
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "xhigh",
      "service_tier": "fast"
    }
  },
  "reclaim_after_seconds": 21600,
  "runner_timeout_seconds": 3600
}
