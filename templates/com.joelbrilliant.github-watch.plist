<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joelbrilliant.github-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/github-watch</string>
    <string>--config</string>
    <string>/Users/openclaw/.config/github-watch/config.json</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>Disabled</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/openclaw/.local/state/github-watch/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/openclaw/.local/state/github-watch/launchd.err.log</string>
</dict>
</plist>
